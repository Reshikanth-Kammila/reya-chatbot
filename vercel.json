{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/sessions(.*)",    "dest": "/api/index.py" },
    { "src": "/chat(.*)",        "dest": "/api/index.py" },
    { "src": "/notes(.*)",       "dest": "/api/index.py" },
    { "src": "/reminders(.*)",   "dest": "/api/index.py" },
    { "src": "/auth(.*)",        "dest": "/api/index.py" },
    { "src": "/cron-check(.*)",  "dest": "/api/index.py" },
    { "src": "/(.*)",            "dest": "/frontend/$1"  }
  ]
}
